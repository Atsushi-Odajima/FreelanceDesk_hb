# ---- 必須 ----
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME   # マネージドDBでSSL必須なら ?sslmode=require を付与
APP_ORIGIN=https://desk.example.com                      # 公開URL（CSRFのOrigin検証に使用）

# ---- 任意 ----
PORT=3000
NODE_ENV=production
APP_TZ=Asia/Tokyo                 # 期限・今日の判定に使うタイムゾーン
SECURE_COOKIES=true               # HTTPS配信時は true（本番既定 true）
TRUST_PROXY=true                  # リバースプロキシ配下（Render等）で X-Forwarded-For を信頼
TRUST_PROXY_HOPS=1                # X-Forwarded-For の右端から何番目を利用者IPとみなすか（プロキシ段数）
SIGNUP_CODE_REQUIRED=true         # 購入者コードのない登録を拒否（npm run codes:create で発行）
DEMO_ENABLED=true                 # ログイン画面の「サンプルデータで試す」
DEMO_ACCOUNT_TTL_HOURS=24
UPLOAD_MAX_BYTES=10485760         # 1ファイル上限（10MB）
ACCOUNT_STORAGE_QUOTA_BYTES=524288000  # 1アカウントの添付合計上限（500MB）
RESTORE_MAX_BYTES=314572800       # バックアップ復元ファイル上限
SESSION_DAYS=30
# RATE_LIMIT_RELAXED_FOR_TESTS=true   # 自動テスト専用。本番では設定しない
